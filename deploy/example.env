AGENTSHARK_LISTEN_ADDR=0.0.0.0:8080
AGENTSHARK_ENVIRONMENT=local
AGENTSHARK_ADMIN_TOKEN=change-me-before-use
AGENTSHARK_AUTH_DISABLED=false
AGENTSHARK_COOKIE_SECURE=true
AGENTSHARK_BIND=127.0.0.1
AGENTSHARK_PORT=8080
AGENTSHARK_UPSTREAM_TIMEOUT=3s
AGENTSHARK_UPSTREAM_RETRY_MAX=1
AGENTSHARK_SCAN_TIMEOUT=90s
AGENTSHARK_DATABASE_URL=postgresql://agentshark:change-me-before-use@postgres:5432/agentshark?sslmode=disable
AGENTSHARK_DATABASE_AUTO_MIGRATE=true
AGENTSHARK_DATABASE_PASSWORD=change-me-before-use
AGENTSHARK_DATABASE_MAX_CONNS=10
AGENTSHARK_DATABASE_MIN_CONNS=1
AGENTSHARK_DATABASE_CONNECT_TIMEOUT=5s
AGENTSHARK_EVENT_RETENTION=720h
AGENTSHARK_TRACE_RETENTION=720h
# Zero disables durable complete Audit payload capture. Metadata remains durable.
AGENTSHARK_PAYLOAD_RETENTION=0s
AGENTSHARK_OUTBOX_RETENTION=24h
AGENTSHARK_DATABASE_BIND=127.0.0.1
AGENTSHARK_DATABASE_PORT=55432

# Phase 14 OTLP/HTTP Trace ingest. preview-bootstrap generates the token.
AGENTSHARK_TRACE_INGEST_TOKEN=change-me-before-use
AGENTSHARK_TRACE_ENDPOINT=http://127.0.0.1:4318/v1/traces
AGENTSHARK_TRACE_CONTENT_MODE=metadata
AGENTSHARK_TRACE_PAYLOAD_LIMIT_BYTES=262144
AGENTSHARK_TRACE_PAYLOAD_RETENTION=24h
# Repository-local Python SDK defaults. AgentGuard URL/API key remain
# agent-process settings and are not copied into the BFF.
AGENTSHARK_TRACE_EXPORT_TIMEOUT_SECONDS=10
AGENTSHARK_TRACE_FLUSH_TIMEOUT_SECONDS=10
AGENTSHARK_TRACE_BATCH_DELAY_MS=1000
AGENTSHARK_TRACE_MAX_QUEUE_SIZE=2048
AGENTSHARK_TRACE_MAX_EXPORT_BATCH_SIZE=512
AGENTSHARK_GUARD_ENABLED=true
AGENTSHARK_GUARD_FAILURE_MODE=closed
AGENTSHARK_GUARD_TIMEOUT_SECONDS=5
AGENTSHARK_GUARD_REMOTE_RETRIES=0

# Phase 16 Demo Lab. The Compose overlay enables the feature; the base preview
# remains disabled. preview-bootstrap replaces the Runner token placeholder.
AGENTSHARK_DEMO_ENABLED=false
AGENTSHARK_DEMO_RUNNER_URL=http://demo-runner:39100
AGENTSHARK_DEMO_RUNNER_TOKEN=change-me-before-use
AGENTSHARK_DEMO_MAX_CONCURRENCY=1
AGENTSHARK_DEMO_DEFAULT_DELAY_MS=700
AGENTSHARK_DEMO_RUN_TIMEOUT=10m
AGENTSHARK_DEMO_MONITOR_INTERVAL=750ms
AGENTSHARK_DEMO_COLLECTOR_READY_URL=http://agentshark-collector:4318/readyz
AGENTSHARK_DEMO_LLM_BASE_URL=http://agentshark-demo-gateway:39000/v1
AGENTSHARK_DEMO_LLM_MODEL=agentshark-demo-model-v1
AGENTSHARK_DEMO_MCP_URL=http://demo-fixtures:39200/mcp
AGENTSHARK_DEMO_GATEWAY_ADMIN_URL=http://agentshark-demo-gateway:15000
AGENTSHARK_DEMO_GATEWAY_CONSOLE_URL=http://127.0.0.1:15010
AGENTSHARK_DEMO_GATEWAY_ADMIN_BIND=127.0.0.1
AGENTSHARK_DEMO_GATEWAY_ADMIN_PORT=15010

# Direct-binary override. Compose always listens on 0.0.0.0:4318 internally.
AGENTSHARK_COLLECTOR_LISTEN_ADDR=0.0.0.0:4318
AGENTSHARK_COLLECTOR_BIND=127.0.0.1
AGENTSHARK_COLLECTOR_PORT=4318
# Empty uses AGENTSHARK_DATABASE_URL for the local preview. Production may
# supply a Trace-write-only PostgreSQL account here.
AGENTSHARK_COLLECTOR_DATABASE_URL=
AGENTSHARK_COLLECTOR_DATABASE_MAX_CONNS=10
AGENTSHARK_COLLECTOR_DATABASE_MIN_CONNS=1
AGENTSHARK_COLLECTOR_DATABASE_CONNECT_TIMEOUT=5s
AGENTSHARK_COLLECTOR_REQUEST_TIMEOUT=10s
AGENTSHARK_COLLECTOR_MAX_COMPRESSED_BYTES=4194304
AGENTSHARK_COLLECTOR_MAX_DECOMPRESSED_BYTES=16777216
AGENTSHARK_COLLECTOR_MAX_SPANS_PER_REQUEST=2048

AGENTGATEWAY_BASE_URL=http://agentgateway:15000
AGENTGATEWAY_ADMIN_TOKEN=
AGENTGATEWAY_CONSOLE_URL=http://localhost:15000/ui
AGENTGATEWAY_RUNTIME_MODE=standalone
# auto selects Docker Desktop bridging or native Linux host networking.
AGENTGATEWAY_DOCKER_HOST_MODE=auto
AGENTGATEWAY_ADMIN_BIND=127.0.0.1
AGENTGATEWAY_ADMIN_PORT=15000
AGENTGATEWAY_METRICS_BIND=127.0.0.1
AGENTGATEWAY_METRICS_PORT=15020
AGENTGATEWAY_READINESS_BIND=127.0.0.1
AGENTGATEWAY_READINESS_PORT=15021
# preview-bootstrap replaces these with the owner of deploy/agentgateway/config.yaml.
AGENTGATEWAY_RUNTIME_UID=65532
AGENTGATEWAY_RUNTIME_GID=65532

AGENTGUARD_BASE_URL=http://agentguard:38080
AGENTGUARD_ADMIN_TOKEN=change-me-before-use
AGENTGUARD_CONSOLE_URL=http://localhost:38008
AGENTGUARD_API_BIND=127.0.0.1
AGENTGUARD_API_PORT=38080
AGENTGUARD_CONSOLE_BIND=127.0.0.1
AGENTGUARD_CONSOLE_PORT=38008
AGENTGUARD_SERVER_PLUGIN_CONFIG=./config/plugins.json
AGENTGUARD_POLICY=
AGENTGUARD_LLM_BASE_URL=
AGENTGUARD_LLM_MODEL=
AGENTGUARD_LLM_API_KEY=
# Thought-Aligner is opt-in. Also select plugins.thought-aligner.example.json.
THOUGHT_ALIGNER_BASE_URL=
THOUGHT_ALIGNER_MODEL=
THOUGHT_ALIGNER_API_KEY=

AGENTSHARK_POLL_INTERVAL=2s
